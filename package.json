{
  "name": "markgrove",
  "productName": "MarkGrove",
  "version": "0.1.0",
  "description": "MarkGrove (墨林) — explore and edit Markdown as interactive mind maps.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^35.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-monaco-editor": "^1.1.0",
    "wait-on": "^8.0.0"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "chokidar": "^4.0.0",
    "electron-store": "^8.2.0",
    "mdast-util-to-markdown": "^2.1.0",
    "mind-elixir": "^5.0.0",
    "monaco-editor": "^0.56.0",
    "prismjs": "^1.30.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "rehype-highlight": "^7.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0",
    "zustand": "^5.0.0"
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "esbuild@0.25.12": true
  }
}
